    "platform_profile": {
      "operation": "chapter.platform_profile.author",
      "content": {
        "type": "platform_profile",
        "safe_summary": "正文必须为中文，每章 2000–3500 汉字（HAN_CHARACTERS_V1）；内部试读，不公开发布。",
        "structured_facts": [
          {
            "key": "platform_rules",
            "value": {
              "chapter_length": {
                "unit": "HAN_CHARACTERS_V1",
                "minimum": 2000,
                "maximum": 3500
              },
              "format": {
                "paragraph_max": 500
              },
              "sensitive_content": [],
              "ai_content": {
                "mode": "internal"
              },
              "opening": [
                "通过具体行动建立当前冲突与人物所知边界"
              ],
              "rhythm": [
                "建立、推进、兑现须有可定位的正文证据"
              ],
              "publish_metadata": {
                "title_required": true
              }
            }
          }
        ],
        "profile_id": "chinese-private-pilot-v1",
        "constraints": [
          "连续三章，每章正文 2000–3500 汉字，标点、数字、空白和拉丁字母不计；禁止用摘要或重复解释凑长度。",
          "全篇简体中文；第三人称限知，固定沈芦 POV；叙述者不得提前揭示 POV 未能获得的信息。",
          "沈芦的对白简短、具体，紧张时借工具和测量讲道理；其他人物的声音必须从正式生成的人物经历、欲望和关系中产生。",
          "基调克制、有紧迫感；通过动作、空间和有代价的选择推进，避免用旁白连续讲道理。",
          "三章形成建立、推进、兑现；建立至少一项能在后文验证的承诺，一次人物与读者的信息差，以及每章明确的局势或关系变化。",
          "关键行动必须有动机、可知的信息、代价和后果；传闻、对白断言与客观事实分别处理。",
          "收束当前短 Arc 的核心选择及其后果，不以达到章节数替代完成；未兑现承诺必须明确保留。",
          "只做内部试读；不使用真实个人私密资料、不描绘露骨性内容、不模仿已出版作品表达。"
        ]
      }
