{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-forge.local/schemas/chapter_plan.schema.json",
  "title": "ChapterPlan",
  "description": "Chapter-level plan that must exist before drafting prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "chapter_no",
    "title",
    "volume",
    "position",
    "pov",
    "scene",
    "characters",
    "chapter_goal",
    "main_conflict",
    "emotional_curve",
    "plot_beats",
    "information_gain",
    "cool_points",
    "foreshadowing",
    "suspense",
    "ending_hook",
    "continuity",
    "draft_instructions",
    "quality_gate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chapter_plan_[A-Za-z0-9_-]+$"
    },
    "project_id": {
      "type": "string"
    },
    "chapter_no": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "volume": {
      "type": "integer",
      "minimum": 1
    },
    "position": {
      "type": "string",
      "enum": [
        "opening",
        "early",
        "middle",
        "climax",
        "transition",
        "ending"
      ]
    },
    "pov": {
      "type": "string"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "time",
        "atmosphere"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "atmosphere": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "mentioned"
      ],
      "properties": {
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mentioned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chapter_goal": {
      "type": "string"
    },
    "main_conflict": {
      "type": "string"
    },
    "emotional_curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "pressure",
        "turn",
        "release"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "pressure": {
          "type": "string"
        },
        "turn": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      }
    },
    "plot_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beat",
          "content",
          "function"
        ],
        "properties": {
          "beat": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      }
    },
    "information_gain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cool_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "foreshadowing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suspense": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ending_hook": {
      "type": "string"
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "next"
      ],
      "properties": {
        "previous": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      }
    },
    "draft_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "pacing",
        "avoid"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "pacing": {
          "type": "string"
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_goal",
        "has_conflict",
        "has_information_gain",
        "has_emotional_change",
        "has_cool_point_or_pressure",
        "has_ending_hook"
      ],
      "properties": {
        "has_goal": {
          "type": "boolean"
        },
        "has_conflict": {
          "type": "boolean"
        },
        "has_information_gain": {
          "type": "boolean"
        },
        "has_emotional_change": {
          "type": "boolean"
        },
        "has_cool_point_or_pressure": {
          "type": "boolean"
        },
        "has_ending_hook": {
          "type": "boolean"
        }
      }
    }
  }
}
