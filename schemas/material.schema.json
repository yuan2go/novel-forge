{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-forge.local/schemas/material.schema.json",
  "title": "Material",
  "description": "Raw or processed source material metadata for NovelForge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source_type",
    "storage_stage",
    "source",
    "rights",
    "created_at",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^material_[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "hot_novel",
        "professional_book",
        "article",
        "reader_comment",
        "inspiration",
        "manual_note"
      ]
    },
    "storage_stage": {
      "type": "string",
      "enum": [
        "raw",
        "cleaned",
        "chunk",
        "metadata_only"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "origin",
        "locator"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "user_provided",
            "public_domain",
            "owned_original",
            "licensed",
            "metadata_only",
            "unknown"
          ]
        },
        "locator": {
          "type": "string",
          "description": "Path, URL, citation, or local reference. Do not store secrets."
        },
        "author": {
          "type": "string"
        },
        "publication_date": {
          "type": "string"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyright_status",
        "usage_boundary"
      ],
      "properties": {
        "copyright_status": {
          "type": "string",
          "enum": [
            "owned",
            "licensed",
            "public_domain",
            "analysis_only",
            "unknown"
          ]
        },
        "usage_boundary": {
          "type": "string",
          "enum": [
            "metadata_only",
            "abstract_analysis_only",
            "internal_reference",
            "reusable_original_asset"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "path": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
