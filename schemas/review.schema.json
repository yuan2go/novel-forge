{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-forge.local/schemas/review.schema.json",
  "title": "Review",
  "description": "Quality review report for plans, drafts, chapters, or project assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target_file",
    "review_type",
    "reviewer_model",
    "review_date",
    "score",
    "major_issues",
    "minor_issues",
    "keep",
    "revise_priority",
    "final_decision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^review_[A-Za-z0-9_-]+$"
    },
    "target_file": {
      "type": "string"
    },
    "review_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "structure",
          "logic",
          "commercial",
          "discipline",
          "originality",
          "prose",
          "world",
          "character",
          "feedback"
        ]
      }
    },
    "reviewer_model": {
      "type": "string",
      "enum": [
        "chatgpt",
        "codex",
        "claude_code",
        "deepseek",
        "human_editor"
      ]
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "pacing",
        "cool_points",
        "character",
        "world_logic",
        "prose",
        "originality"
      ],
      "properties": {
        "structure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cool_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "character": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "world_logic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "prose": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "originality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "major_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "severity",
          "reason",
          "fix"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "minor_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "severity",
          "reason",
          "fix"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revise_priority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_decision": {
      "type": "string",
      "enum": [
        "pass",
        "minor_revision",
        "major_revision",
        "return_to_outline",
        "blocked"
      ]
    }
  }
}
