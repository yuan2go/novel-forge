{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-forge.local/schemas/topic.schema.json",
  "title": "Topic",
  "description": "Commercial story direction that can be developed into a NovelForge project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "genre",
    "core_hook",
    "reader_expectation",
    "commercial_tags",
    "differentiation",
    "core_conflict",
    "world_requirements",
    "character_requirements",
    "risk",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^topic_[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "core_hook": {
      "type": "string"
    },
    "reader_expectation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commercial_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "differentiation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external",
        "internal",
        "social"
      ],
      "properties": {
        "external": {
          "type": "string"
        },
        "internal": {
          "type": "string"
        },
        "social": {
          "type": "string"
        }
      }
    },
    "world_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_requirements": {
      "type": "object"
    },
    "risk": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "candidate",
        "approved",
        "rejected",
        "archived"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
