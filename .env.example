NOVEL_FORGE_ROOT=.local/workspace
NOVEL_FORGE_ENVIRONMENT=development
NOVEL_FORGE_STORAGE_AUTHORITY=postgresql
NOVEL_FORGE_AUTHORITY_RUNTIME_PROFILE=full
NOVEL_FORGE_DATABASE_URL=postgresql://novel_forge:novel_forge@localhost:5432/novel_forge

NOVEL_FORGE_MINIO_ENDPOINT=localhost:9000
NOVEL_FORGE_MINIO_ACCESS_KEY=novel_forge
NOVEL_FORGE_MINIO_SECRET_KEY=novel_forge_secret
NOVEL_FORGE_MINIO_SECURE=false
NOVEL_FORGE_MINIO_RAW_BUCKET=novel-forge-raw
NOVEL_FORGE_MINIO_ARTIFACT_BUCKET=novel-forge-artifacts
NOVEL_FORGE_MINIO_EXPORT_BUCKET=novel-forge-exports

NOVEL_FORGE_API_HOST=127.0.0.1
NOVEL_FORGE_API_PORT=8000
NOVEL_FORGE_API_CORS_ORIGINS=http://localhost:3000

# PostgreSQL Authority / governed model execution. Provider/model selection is
# frozen into each Operation route snapshot; never place credentials in commands.
NOVEL_FORGE_AUTHORITY_WORKER_ID=chapter-authority-worker
NOVEL_FORGE_BOOK_FOLLOWUP_WORKER_ID=book-followup-authority-worker
# NOVEL_FORGE_MODEL_PROVIDER=
# NOVEL_FORGE_READER_OUTCOME_PROVIDER=
# NOVEL_FORGE_READER_OUTCOME_MODEL=
# NOVEL_FORGE_PROVIDER_AUTH_PROFILE=
# NOVEL_FORGE_PROVIDER_MODEL_CONTEXT_LIMIT=
# NOVEL_FORGE_PROVIDER_TOKEN_ACCOUNTING_METHOD=OPENAI_UTF8_BYTES_UPPER_BOUND_V1
# NOVEL_FORGE_PROVIDER_TOKEN_ACCOUNTING_EVIDENCE_REF=
# NOVEL_FORGE_PROVIDER_TOKEN_SAFETY_MARGIN=256
# NOVEL_FORGE_PROVIDER_TOKEN_FRAMING_OVERHEAD=16
# NOVEL_FORGE_SOURCE_PROVIDER_OUTPUT_TOKEN_RESERVE=4096
