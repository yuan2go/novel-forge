# NovelForge environment example
# Copy this file to .env for local development.
# Do not commit .env or real secrets.

NOVELFORGE_ENV=local
NOVELFORGE_PROJECT_ROOT=.
NOVELFORGE_WORKSPACE_DIR=04_novel_projects
NOVELFORGE_TEMPLATES_DIR=templates
NOVELFORGE_DOCS_DIR=docs

# Model API placeholders. Keep empty unless needed locally.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional model names for future integration.
NOVELFORGE_PLANNING_MODEL=
NOVELFORGE_WRITING_MODEL=
NOVELFORGE_REVIEW_MODEL=
NOVELFORGE_FEEDBACK_MODEL=

# Safety switches.
NOVELFORGE_DRY_RUN=true
NOVELFORGE_ALLOW_EXTERNAL_API=false
NOVELFORGE_ALLOW_OVERWRITE=false
