NOVEL_FORGE_ROOT=.

NOVEL_FORGE_DATABASE_URL=postgresql://novel_forge:novel_forge@localhost:5432/novel_forge
NOVEL_FORGE_REDIS_URL=redis://localhost:6379/0
NOVEL_FORGE_CELERY_BROKER_URL=redis://localhost:6379/0
NOVEL_FORGE_CELERY_RESULT_BACKEND=redis://localhost:6379/1
NOVEL_FORGE_CELERY_DEFAULT_QUEUE=novel-forge
NOVEL_FORGE_CELERY_TASK_SOFT_TIME_LIMIT=1800
NOVEL_FORGE_CELERY_TASK_TIME_LIMIT=2100
NOVEL_FORGE_CELERY_IDEMPOTENCY_TTL_SECONDS=86400

NOVEL_FORGE_QDRANT_URL=http://localhost:6333
NOVEL_FORGE_QDRANT_COLLECTION=novel_forge_assets
NOVEL_FORGE_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# OPENAI_API_KEY=sk-...

NOVEL_FORGE_MINIO_ENDPOINT=localhost:9000
NOVEL_FORGE_MINIO_ACCESS_KEY=novel_forge
NOVEL_FORGE_MINIO_SECRET_KEY=novel_forge_secret
NOVEL_FORGE_MINIO_SECURE=false
NOVEL_FORGE_MINIO_RAW_BUCKET=novel-forge-raw
NOVEL_FORGE_MINIO_ARTIFACT_BUCKET=novel-forge-artifacts
NOVEL_FORGE_MINIO_EXPORT_BUCKET=novel-forge-exports

NOVEL_FORGE_API_HOST=127.0.0.1
NOVEL_FORGE_API_PORT=8000
NOVEL_FORGE_API_CORS_ORIGINS=http://localhost:3000

NOVEL_FORGE_ENABLE_NEO4J=false
NOVEL_FORGE_NEO4J_URI=bolt://localhost:7687
NOVEL_FORGE_NEO4J_USER=neo4j
NOVEL_FORGE_NEO4J_PASSWORD=novel_forge_graph
