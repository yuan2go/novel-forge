  "creative_requirements": {
    "style": {
      "policies": [
        {
          "constraints": [
            "正文主要使用简体中文，单章2500—3500中文字。",
            "用动作、感官差别和实际结果呈现修炼进步，避免只有境界名称或旁人赞叹。",
            "规则在人物准备使用、面临限制或作出选择时解释，控制一次新增术语的数量。",
            "对话体现当下目的和不同利益，同门可以拒绝、讨价还价或改变安排。",
            "写清场景内的行动过程与结果，章际承接前章动作、资源变化和人物承诺。",
            "不把练习一律写成痛苦硬撑，也不把每次选择都包装成重大牺牲。",
            "比喻尽量来自沈砚能够接触的山村生活与宗门经验。",
            "以下例句均为原创表达示范，不代表已发生场景或已确认世界规则。"
          ],
          "content_hash": "sha256:e2f8f569056cd7adc8fe0fb8b0a6f9371abcb79b60a5a5551de6014f615244d7",
          "safe_summary": "Apply the exact approved Foundation voice and original craft examples.",
          "asset_version_id": "authority-output:afebcb98-fec9-43f4-bcc2-20c1d6cc4191:chapter.style_policy:v1",
          "structured_facts": [
            {
              "kind": "voice_contract",
              "layer": "NARRATOR",
              "guidance": "朴素、清楚且有分寸的第三人称叙述者。重视人物正在做什么、为何这样做及做完后改变了什么；情绪通过观察、动作和简短内心呈现。",
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:NARRATOR",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "GENRE",
              "guidance": [
                "以引气、功法练习和实际运用建立修炼成长的可信过程。",
                "通过外门课程、劳作与任务展现宗门生活的日常秩序。",
                "让资源数量与用途清楚，资源争取服务具体修炼需求。",
                "历练包含准备、执行和结果承接，伙伴的能力与判断影响任务。",
                "飞剑与远行作为长期向往逐步进入实际学习和使用，而非开篇即具备。"
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:GENRE",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "CHARACTER",
              "guidance": [
                {
                  "situation": "问询一项尚未接受的劳作安排时。",
                  "utterance": "这份活要做到什么时候？我想先算算，做完还能不能留一段练习的工夫。",
                  "motivation": "把差事与修行需要联系起来，保留主动选择的余地。"
                },
                {
                  "situation": "未来一次基础引气尝试后，向教习说明自己观察到的不足。",
                  "utterance": "刚才呼吸慢下来时，我还能留住一点。再往后就散了。我想再试一遍，看是不是急在这里。",
                  "motivation": "通过具体差别寻求指导，而非只求肯定。"
                },
                {
                  "situation": "协商首次结伴采药的路线时。",
                  "utterance": "我想多认一段路，可你要按时回来。先把回程留够；剩下的工夫，我们再商量去哪一处。",
                  "motivation": "同时表达个人目标与对同行承诺的尊重。"
                }
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:character:shen-yan",
              "character_id": "character:shen-yan",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "CHARACTER",
              "guidance": [
                {
                  "situation": "收到尚未说明回程安排的采药邀请时。",
                  "utterance": "能去。先说什么时候回来，别到了谷里才一处接一处地加。",
                  "motivation": "在答应同行前保留自己的时间边界。"
                },
                {
                  "situation": "检查拟用于同行的携行工具时。",
                  "utterance": "背带我来调。你把采收说明问清，咱们各做一件，别两个人都等着。",
                  "motivation": "凭自己的长处承担一项实际工作，同时要求互惠。"
                },
                {
                  "situation": "同行者提出在任务途中多看一处观察点时。",
                  "utterance": "值得看就说说为什么。能留出回程工夫，我也想认一认；留不出来，就另约一次。",
                  "motivation": "让额外学习进入协商，而非一概拒绝。"
                }
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:character:lu-heng",
              "character_id": "character:lu-heng",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "CHARACTER",
              "guidance": [
                {
                  "situation": "准备采药时，有人询问她是否认识目标药材。",
                  "utterance": "我会分拣普通草药，折露草还得照说明认。先给我看清楚，别凭这个就算我会。",
                  "motivation": "守住信息边界，避免生活经验被误当作任务知识。"
                },
                {
                  "situation": "商定材料保管办法时。",
                  "utterance": "湿的和干的先分开。我来复查，你帮我留一块干净地方，免得一路压坏。",
                  "motivation": "保护交付质量，并把自己的要求落实为分工。"
                },
                {
                  "situation": "任务途中发现值得核实的细小差别时。",
                  "utterance": "这里有个差别，我想再看一眼。要是耽误回程，我先记下来，下次带着问题来。",
                  "motivation": "争取观察机会，同时承认同行者的安排。"
                }
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:character:tang-sui",
              "character_id": "character:tang-sui",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "CHARACTER",
              "guidance": [
                {
                  "situation": "有人只说引气练习没有进展时。",
                  "utterance": "先别说全都不对。哪一步还能维持，哪一步开始散？从那里说。",
                  "motivation": "让求助者提供可用于指导的观察。"
                },
                {
                  "situation": "未来观察到弟子一次短暂成功后。",
                  "utterance": "刚才这一回有差别。歇一歇，再照原来的做法试，看看能不能重复。",
                  "motivation": "区分一次感觉与可重复的操作能力。"
                },
                {
                  "situation": "沈砚询问自己是否能够参加正式课程时。",
                  "utterance": "你的练习，我能说亲眼看到的部分。课位和入课条件，要核实当期安排，不能把这两件事混在一起。",
                  "motivation": "提供能力反馈，同时保持正式课程的权限和条件边界。"
                }
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:character:xu-ting",
              "character_id": "character:xu-ting",
              "required_markers": [],
              "forbidden_markers": []
            },
            {
              "kind": "voice_contract",
              "layer": "CHARACTER",
              "guidance": [
                {
                  "situation": "沈砚提出更换尚需核实的劳动安排时。",
                  "utterance": "先说要改哪一段，再说原来的事怎么接上。两边都说明白，才知道能不能办。",
                  "motivation": "让调整请求能够被具体处理。"
                },
                {
                  "situation": "有人把任务牌上的报酬当作所需物资必然可得时。",
                  "utterance": "牌上写的是这项任务的条件。你要换什么，还得查那边的实际供给，不能只看报酬。",
                  "motivation": "区分任务报酬与兑换对象的实际供给。"
                },
                {
                  "situation": "有人要求他直接确认正式课程资格时。",
                  "utterance": "劳动安排我能核对。入课条件要问教习组；等那边说清，再看两边时间有没有冲突。",
                  "motivation": "在部门职责边界内给出下一步回应。"
                }
              ],
              "voice_id": "db9855a3-5d98-44ba-9f09-3ce437a9cb31:character:cheng-guan",
              "character_id": "character:cheng-guan",
              "required_markers": [],
              "forbidden_markers": []
            },
