{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "execution_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tension_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "composition_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "creative_guidance": {
      "type": "object",
      "properties": {
        "chapter_goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pov": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "emotional_turn": {
          "type": [
            "string",
            "null"
          ]
        },
        "reader_promise": {
          "type": [
            "string",
            "null"
          ]
        },
        "ending_change": {
          "type": [
            "string",
            "null"
          ]
        },
        "character_choices": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "character_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "choice": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "motivation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "cost": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "character_id",
              "choice",
              "motivation",
              "cost"
            ],
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "chapter_goal",
        "pov",
        "voice",
        "emotional_turn",
        "reader_promise",
        "ending_change",
        "character_choices",
        "constraints"
      ],
      "additionalProperties": false
    },
    "scene_directives": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "directive": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "conflict_progression": {
            "type": [
              "string",
              "null"
            ]
          },
          "information_release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "emotional_change": {
            "type": [
              "string",
              "null"
            ]
          },
          "transition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "scene_id",
          "directive",
          "conflict_progression",
          "information_release",
          "emotional_change",
          "transition"
        ],
        "additionalProperties": false
      }
    },
    "retrieval_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "obligation_actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "obligation_id",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "arc_actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "arc_plan_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "arc_plan_version_id",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "stop_conditions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "required": [
    "execution_strategy",
    "tension_strategy",
    "composition_strategy",
    "creative_guidance",
    "scene_directives",
    "retrieval_queries",
    "obligation_actions",
    "arc_actions",
    "stop_conditions"
  ],
  "additionalProperties": false
}
