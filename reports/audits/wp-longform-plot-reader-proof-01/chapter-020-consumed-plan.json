      {
        "goal": "按已约分工选择可走的路线和合用土，实际装成第一筐。",
        "beats": [
          {
            "beat_id": "cg20-s2-b1",
            "ordinal": 1,
            "function": "三人当日携空筐出发；沈砚只凭自己走过的湿路与眼前路况提出避开湿滑近路，三人选稍稳的路线。",
            "expected_reader_effect": "看见沈砚把已亲历的湿路经验转为共同路线选择。"
          },
          {
            "beat_id": "cg20-s2-b2",
            "ordinal": 2,
            "function": "到取土处后，唐穗摸辨细而有黏性的土，把含砂或过湿、拿不准的土另置；陆衡按约搬运，沈砚看落脚处并背筐。",
            "expected_reader_effect": "感到土质差别和分工确实影响劳动。"
          },
          {
            "beat_id": "cg20-s2-b3",
            "ordinal": 3,
            "function": "三人不为赶路混入不合用土，装成第一筐并带出取土处；两只空筐仍须在约定时段内装好。",
            "expected_reader_effect": "获得第一批实物成果，同时期待余下交付。"
          }
        ],
        "conflict": "湿滑近路、混杂土质和有限体力使快速取满三筐的办法不可靠。",
        "scene_id": "cg20-scene-2",
        "exit_state": "三人当日避开湿滑近路，到取土处按约看路、辨料和搬运；唐穗分开放置不同手感的土，第一筐合用细土已经装成并被带出取土处，另两只空筐及全部交付仍待完成。",
