  "content": {
    "type": "PlanningGenerationCandidate",
    "title": "第一筐细土",
    "chapter_number": 20,
    "objective": "在同章说明并启动三筐细土的有限共同任务，让三人依自身目标分工、择路、选料，取得第一筐合用细土。",
    "premise": "程观说明修补晾药陶盘所需的细土任务。沈砚、唐穗和陆衡各选职责，避开湿滑近路，带着第一筐合用细土走出取土处。",
    "scene_plan": [
      {
        "goal": "听清当期任务，并在不挤占既有安排的前提下决定能承担的部分。",
        "beats": [
          {
            "beat_id": "cg20-s1-b1",
            "ordinal": 1,
            "function": "沈砚带着已交回落枝、亲历湿路的经验来到任务处；程观正处理晾药陶盘修补所需材料。",
            "expected_reader_effect": "接续沈砚已完成的落枝劳动，感到新任务有清楚来由。"
          },
          {
            "beat_id": "cg20-s1-b2",
            "ordinal": 2,
            "function": "程观在三人面前说明三只陶盘、最多三小筐、合用与另置土的区别、交付办法及交付后每人一份当晚热饭。",
            "expected_reader_effect": "明确用途、上限、质量和回报，形成可执行的共同目标。"
          },
          {
            "beat_id": "cg20-s1-b3",
            "ordinal": 3,
            "function": "唐穗选择辨料并希望得到质量反馈；陆衡限定搬运量以保留练杆时段；沈砚承担看路和背筐，三人按可用时段约定同行。",
            "expected_reader_effect": "看见三人的目标都实际改变分工。"
          }
        ],
        "conflict": "三人想从任务中取得的东西和可用时段不同，须在有限数量与交付条件内商定各自承担部分。",
        "scene_id": "cg20-scene-1",
        "exit_state": "程观已当场说明三只晾药陶盘修补所需细土的用途、最多三小筐、质量与另置要求、交付方式及完整交付后的热饭回报；沈砚、唐穗、陆衡各按目标和时段同意有限分工，尚未出发取土。",
        "story_time": {
          "precision": "ORDERED",
          "end_ordinal": 2,
          "timeline_id": "timeline:chapter-20-day",
          "start_ordinal": 1
        },
        "entry_state": "第19章的工作经历中，沈砚已将两根合用落枝交回程观，记得自己亲历的湿路与岔口；三人尚未听到本次细土任务的具体条件，也未取得材料。",
        "location_id": "location:qinglan-task-yard",
        "arc_progress": [
