  "exit_state_spec": {
    "summary": "拟在第25章让已验收的三筐细土进入可见修盘用途，沈砚完成一件有限帮手行动；第26章许庭在基础教学范围内说明木片反馈的意义和限度，沈砚经多次实践形成固定条件下可主动重复的短时基础流转；第27章他自行使用该方法完成当日练习并选择下一项可检验条件。唐穗保有辨料兴趣，许庭保有自己的修炼时段；这些均为未来候选结果。"
  },
  "local_objective": "用第25章的实际劳动结果承接共同任务，再以第26—27章的有来源教学与使用，使木片经验转化为有限但真实的基础本领。",
  "primary_arc_ids": [
    "authority-output:00e504d1-3452-4c05-b47d-bb85f2302549:story_planning.candidate:v1"
  ],
  "quality_targets": {
    "minimum": 80
  },
  "required_events": [
    "第25章承接已验收细土及已领热饭的工作经历，现场完成一件有用途的有限帮手行动。",
    "第26章由许庭在基础教学范围内说明木片浅纹的用途和限度，沈砚经修正与多次成功形成固定条件下可重复的短时起收。",
    "第27章沈砚自行使用所得完成练习，并让这项进步影响他与唐穗交流及下一步选择。"
  ],
  "character_deltas": [
    {
      "change": "由第24章能够记录脚手差别、尚不知木片反馈用途，变为在固定条件下可主动重复短时基础流转，并能自行安排一段有终点的练习。",
      "subject": "沈砚"
    },
    {
      "change": "依据实际所见选择教学内容，说明木片的反馈意义与能力边界，随后按原有时段继续自己的修炼。",
      "subject": "许庭"
    },
    {
      "change": "亲眼看见细土如何用于盘边修补，保留她对辨料用途的个人兴趣，与沈砚交流时提出自己的观察。",
      "subject": "唐穗"
    }
  ],
  "forbidden_events": [
    "改写第24章的两次木片尝试、淡纹及许庭已结束的有限答疑。",
    "重做已经验收的三筐细土任务或重新领取已领过的热饭。",
    "让未知亮纹经旁白直接变成通用法术、境界或正式课程资格。",
    "以未经现场说明的库存、报酬、课位或权限推动事件。",
    "让许庭只作流程评审或无限延长答疑，挤掉她自己的修炼。",
    "让唐穗、陆衡或程观只为沈砚提供赞叹、阻拦或无条件帮助。"
  ],
  "hard_constraints": [
    "第25—27章承接第24章已交付的木片练习；第25章须完成有用途的有限行动，第26章须产生教学与实践支持的具体进步，第27章须让所得改变行动或相处。",
    "三筐细黏土在第21章工作正文中已验收，三人已各领一份当晚热饭；后续只能承接该结果。",
    "许庭为女性，只依据实际见到的练习表现和她有权说明的基础材料指导，保留自己的修炼安排。",
    "木片的意义、用途和限度须从有权的基础教学说明进入沈砚所知；短时重复与跨情境稳定分开。",
    "正式课程录入与基础指导分开，课位及其他条件仍须由有权者核实。",
    "程观只处理自己所知、所负责的事项；修盘具体操作由现场修盘者决定。",
    "人物所知受实际接触限制；任务、物料、时间和任何承诺均按明确来源与用途处理。",
    "使用以沈砚为主的第三人称限知视角，后续正文保持每章2500—3500中文字、段落不超过500中文字。"
  ],
  "planning_horizon": "TACTICAL",
  "required_payoffs": [
    "三筐细土的交付结果在修盘现场有具体用途，不重新验收。",
    "第24章辨认动作差别的努力在第26章成为有教学来源的能力进步。",
    "有限可重复本领在第27章由沈砚独自使用，许庭的帮助产生可见效果。"
  ],
  "soft_constraints": [
    "保留第25章修盘现场的温度、具体劳动感与安静观察。",
    "练习过程写出动作、呼吸、停顿与休息的实际差别，不让说明压过场景。",
    "唐穗与沈砚可以各自选择学习方向，合作不要求同时同地。",
    "章节收尾由主动选择带出期待，不强制危机、反转或悬念。"
  ],
  "arc_contributions": [
    {
      "change": "许庭从辨认沈砚两次木片练习的动作差别，推进到说明木片的基础教学用途，并依多次实际起收限定后续练习范围。",
      "subject": "许庭的有限教学"
    },
    {
      "change": "沈砚完成一次与先前细土交付相连的实际帮手行动，又在固定木片条件下练成可主动重复的短时基础流转。",
      "subject": "沈砚的实践成长"
    },
    {
      "change": "程观对既有细土交付的用途给出现场可见的后续信息，保持任务处理与修盘操作、教学资格的边界。",
      "subject": "程观的工作关系"
    }
  ],
  "budget_policy_ref": "authority-output:e028f0a6-b242-4990-b707-b2f4b09ca34f:book.bootstrap.production_profile:v1",
  "forbidden_payoffs": [
    "用又一次偶然亮纹冒充可重复的基础运用。",
    "用修盘者一句赞许或程观的好感冒充新资源与学习资格。",
    "将固定木片前的短时起收写成任何场合都稳定的法术能力。",
    "把列出下一次问题当作第27章的唯一结果。"
  ],
