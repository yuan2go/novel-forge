        "beats": [
          {
            "beat_id": "chapter38-scene2-beat1",
            "ordinal": 1,
            "function": "沈砚按示范试半转，初次换脚时急着接上下一步，气息随之变浅，掌中细暖散去；他停住，没有用力强留。",
            "expected_reader_effect": "感到转身确有与直行不同的动作难处，失误由可见的脚步抢快造成。"
          },
          {
            "beat_id": "chapter38-scene2-beat2",
            "ordinal": 2,
            "function": "沈砚放下轻物歇息，待肩臂与呼吸缓过，再缩小换脚幅度；他先完成较简短的半转，然后将同一先后次序用于短距离折返。",
            "expected_reader_effect": "看见教学如何转成沈砚自己的调整，而非一句评价。"
          },
          {
            "beat_id": "chapter38-scene2-beat3",
            "ordinal": 3,
            "function": "几轮练习之间留出休息。沈砚在熟悉平地以寻常握力拿着木片，短时缓步转身时多次辨出自身细暖并主动收住；木片的重量始终由手指承担。",
            "expected_reader_effect": "获得限定条件内可重复成功的踏实喜悦。"
          },
