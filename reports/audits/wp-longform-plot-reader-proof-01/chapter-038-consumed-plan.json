  "content": {
    "chapter_number": 38,
    "chapter_intent": "兑现沈砚在第37章选出的转身问题：让许庭在有限答疑时段内依据亲见表现实际教学，让沈砚通过失误、休息、调整和多次成功，把直行收束扩展到熟悉平地的短时缓步转身。",
    "scene_plan": [
      {
        "goal": "让许庭看见已有的直行本领，并获得可立即练习的转身示范。",
        "beats": [
          {
            "beat_id": "chapter38-scene1-beat1",
            "ordinal": 1,
            "function": "沈砚在既有答疑时段向许庭简短说明直行时辨出的步幅差别，并当场走一段短直路。许庭只根据眼前动作观察他能否在行步中主动收束。",
            "expected_reader_effect": "看见第37章的独练确实成为本次请教的起点。"
          },
          {
            "beat_id": "chapter38-scene1-beat2",
            "ordinal": 2,
            "function": "许庭见直行收束确实可行，示范平地缓慢半转，指出脚先抢快时气息容易被带急，让沈砚先练半转，再接折返。",
            "expected_reader_effect": "明白新教学为何只增加转身这一项，以及脚步先后将成为具体难处。"
          }
        ],
        "conflict": "许庭的答疑时间有限，而转身比直行多了脚步换向这一条件；她须按当场表现选取可教的范围。",
        "scene_id": "chapter38-scene1",
        "exit_state": "许庭已亲眼看见沈砚直行缓步并主动收束，决定只增加短时缓步转身这一项控制；她已示范半转时脚步与自身气息的先后，沈砚准备从半转练起，尚未取得转身成功的重复证据。",
        "story_time": {
