  "activation_operation_id": null,
  "semantic_diff": [
    {
      "after": [],
      "field": "arc_contributions",
      "before": [
        {
          "change": "承接初次引气与首课，在不同练习条件下辨认气息进入、短暂接续和散逸，为卷二的稳定重复留下可用的经验。",
          "subject": "修行基础"
        },
        {
          "change": "让已完成的采药和药叶劳作得到有权限、有依据的后续反馈，再安排内容不同的有限事务。",
          "subject": "任务与资源"
        },
        {
          "change": "承接第7章课程录入和第8章首课，将机会转化为实际教学、尝试和反馈。",
          "subject": "学习机会"
        },
        {
          "change": "使许庭、陆衡、唐穗和程观各自的事务与选择影响相处和分工，逐渐形成有来有往的关系。",
          "subject": "同门关系"
        },
        {
          "change": "让沈砚主动选择练习与事务，经历短暂成功、失手和调整，并承担具体结果。",
          "subject": "自主判断"
        },
        {
          "change": "通过亲历宗门修行现象与认识自身限度，保存通向未来独自御剑远行的愿望和因果起点。",
          "subject": "远行愿望"
        }
      ],
      "change_type": "ARC_CONTRIBUTION_CHANGED"
    },
    {
      "after": [
        {
          "change": "从主动争取入门、初次引气，走向能够在明确条件下重复一项有限的基础灵气运用，并把它用于适合其能力的事务；仍需在卷二扩大稳定性、持续时间和适用范围。",
          "subject": "沈砚"
        },
        {
          "change": "对药材辨认和可用收获的重视实际影响后续山林任务的采收、复查与交付方案；她的帮助有自己的目标和时间边界。",
          "subject": "唐穗"
        },
        {
          "change": "自身练习安排实际影响同行时间与分工；在可承担范围内合作，也可提出不同做法。",
          "subject": "陆衡"
        }
      ],
      "field": "character_deltas",
      "before": [
        {
          "change": "工作稿中的入门、短暂气感、结伴采药、课程录入与首课经历得到承接；此后从反复辨认一次微动，走向在不同场所认识修行的多个环节，仍未能独立稳定运用灵气。",
          "subject": "沈砚"
        },
        {
          "change": "在实际教学和约定的答疑范围内回应沈砚，也保有自己的时间与教学判断。",
          "subject": "许庭"
        },
        {
          "change": "按自己的安排决定何时同行、何时分头做事；既有合作经验影响后续协商。",
          "subject": "陆衡"
        },
        {
          "change": "继续重视药材质量与自己的事务，在新的合作中提出需要，而非只替沈砚检查差错。",
          "subject": "唐穗"
        },
        {
          "change": "承接劳动交回职责，传达其权限内的接收与后续核验信息，不代行课程或整批质量审批。",
          "subject": "程观"
        }
      ],
      "change_type": "CHARACTER_DELTA_CHANGED"
    },
    {
