  "context_profile_ref": "authority-output:d74c587d-7dc2-468f-8e11-34f9db4a0195:story_planning.candidate:v1",
  "information_release": [
    "许庭在基础练习范围内说明：木片浅纹是掌前短时流转的回音，沈砚掌中的细暖可帮助他辨认自己起、守、收时手与气息的变化。",
    "修盘者现场指出可移动的盘与放置处，并在搬放结束后确认放妥；盘的质量不由沈砚的灵气判断。",
    "唐穗亲眼看过晾定盘边后，才向沈砚讲她实际看到的接合与外沿情形。",
    "第32章的山林任务条件只通过当期有权来源向沈砚呈现；未确定的数量、报酬与后续结果保持未定。"
  ],
  "relationship_deltas": [
    {
      "change": "许庭在有限时段教沈砚辨认自身用途，之后鼓励他自行实践；师生关系由逐步当面纠正，推进到学生可带着实际结果再来求教。",
      "subject": "许庭与沈砚"
    },
    {
      "change": "唐穗带来盘边的亲眼观察，沈砚带来已完成的搬放与自身小用途；两人各守兴趣，并能商量彼此真正可承担的帮助。",
      "subject": "唐穗与沈砚"
    },
    {
      "change": "程观以当期实际负责的任务条件回应沈砚的选择，形成可执行的下一项工作约定，不预授其他资格。",
      "subject": "程观与沈砚"
    }
  ],
