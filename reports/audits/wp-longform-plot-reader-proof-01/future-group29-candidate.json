  "narrative_event_chain": [
    {
      "action": "沈砚在许庭当次答疑时段简述第27章独练与第28章移步后的真实动作。许庭依据亲述与眼前所见，点明木片浅纹和掌中细暖各自能说明什么，示范松肩、定息与短时收回。他用少量必要复习调整手位，歇过后数次不借木片引出、感受并收回掌中细暖，并说清它只帮助自己认清与调好手和气息。许庭到时回去修炼，嘱他能自行先做，不必每一步都等她在旁。",
      "causes": [],
      "decision": "沈砚决定把注意力从木片亮暗移回自己的掌心、手位与气息，练到能自行开始和收住为止。",
      "event_id": "e29",
      "required": true,
      "slice_id": "chapter-29-self-use",
      "actor_ref": "沈砚",
      "motivation": "沈砚希望已练成的起收离开木片后仍是自己会用的本领；许庭希望有限指导真正帮他自行练习，并保留自己的修炼时段。",
      "resistance": "移步后手位与重心仍需调整，沈砚不能凭木片浅纹替自己感觉掌中的变化。",
      "consequence": "沈砚获得一项由既有实践延伸、仅对自身有用的有限短时起收本领，许庭的指导落实为他能自行实践的方法。",
      "disclosures": [
        "掌中细暖可作为沈砚辨认自己短时流转与手、气息变化的感受，不能判断外物或替他人施术。"
      ],
      "state_deltas": [
        {
          "to_state": "能在无木片时短时自行起、感受并收住掌中细暖，知道它用于辨认自己手与气息的变化且范围有限。",
          "entity_id": "沈砚",
          "from_state": "在木片前已有多次自主起收，移步后曾起收一回，但尚未在无木片时说明和运用自身用途。",
