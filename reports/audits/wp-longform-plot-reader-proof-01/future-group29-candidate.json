  "planning_scope": "CHAPTER_GROUP",
  "schema_version": "story_design.authority.v1",
  "entry_state_ref": "authority-output:7348ab08-90ec-4f36-96b6-684bb23c28ca:book.bootstrap.initial_story_state:v1",
  "exit_state_spec": {
    "summary": "拟在保留第26—28章所选工作连续性的前提下，使沈砚无木片也能短时起收掌中细暖，并在当章完成的陶盘搬放中据此调整自己的手与气息；唐穗获得晾定盘边的现场观察，双方各自选择可做之事。到第32章，沈砚依据当期有权者说明的山林任务条件，选定可承担部分并完成有用的行前准备；山行与交付仍属后续未来设计。"
  },
  "local_objective": "把第26—28章已经形成的基础起收，推进为沈砚能无木片使用、能用于一件完成的日常事务的小本领，再由实际结果导向有来源的下一项山林任务。",
  "primary_arc_ids": [
    "authority-output:00e504d1-3452-4c05-b47d-bb85f2302549:story_planning.candidate:v1"
  ],
  "quality_targets": {
    "minimum": 80
  },
  "required_events": [
    "第29章许庭在当次有限答疑时段说明木片回音与掌中细暖的自身用途，沈砚经必要练习无木片短时起收。",
    "第30章修盘者指定可移动陶盘及位置，沈砚在实际搬放中使用自身小用途调整动作，当章完成搬放。",
    "第31章唐穗亲看晾定盘边并交流所见，沈砚据已完成工作主动提出可承担的帮助。",
    "第32章当期有权来源说明山林任务条件，沈砚选择可承担部分、明确分工并完成实物行前准备。"
  ],
  "character_deltas": [
    {
      "change": "能在无木片时短时自行引出、感受并收回掌中细暖，在陶盘搬放中据此留意手指紧绷并调整普通动作；继而主动选择自己可承担的下一项工作。",
      "subject": "沈砚"
    },
    {
      "change": "以沈砚亲述与当面表现为依据，给出有限而具体的用途指导，并明确鼓励他自行实践；答疑结束后继续自己的修炼。",
      "subject": "许庭"
    },
    {
      "change": "亲看晾定盘边后，把所见用于自己的辨料兴趣，并与沈砚交流各自能做的事。",
      "subject": "唐穗"
    },
    {
      "change": "若当期任务确在职责内，说明任务来源、用途、交付和可调整范围，支持沈砚作出可执行的选择。",
      "subject": "程观"
    }
  ],
  "forbidden_events": [
    "重写第1—28章已选工作，或把工作稿经历称为已接受Canon。",
    "把第28章第一次移步当作第29章才发生。",
    "每换脚位就把已练成的基础起收归零，要求所有独练先经教师亲眼复核。",
    "让许庭授予正式课程、器具或事务权限，或无限延长她的答疑时段。",
    "让掌中细暖作用于外物、判断陶盘或材料质量、替他人施术或治病。",
    "把第30章搬放拖延至下一章，或以反复询问代替行动。",
    "虚构未核实的任务供给、报酬、库存、课位或劳动额度。",
    "第32章提前完成后续山行或交付。"
  ],
  "hard_constraints": [
    "准确规划第29—32章，每章一行章功能；事件链仅覆盖这四章。",
    "保留第1—28章所选工作连续性和accepted_through_chapter为0的正式边界。",
    "沈砚已有第26章木片前数次主动起守收、第27章独练三回、第28章移步后在新站位至少一次起收的工作稿经历，不重复入门或撤销这些进步。",
    "第29章在许庭实际可用的答疑时段完成无木片短时起收及自身小用途的说明与实践，不自动取得正式课程资格。",
    "第30章在修盘者说明可搬盘与放置位置后完成搬放；身体感受只影响沈砚自己的动作选择，物件质量仍由负责者判断。",
    "第31章唐穗对晾定盘边的关心须有现场观察和自主选择；沈砚的帮助须在自己能承担的范围内。",
    "第32章从实际有权来源取得后续山林任务的来源、用途、标准、交付方式及时间条件，并完成可见行前准备；后续执行与交付不得提前。",
    "保持沈砚为主的第三人称限知视角、人物权限和信息来源，单章2500—3500中文字，段落不超过500中文字。",
    "每章同时活跃Arc不超过3，主要状态变化不超过8，新概念不超过4；不制造逾期义务。"
  ],
  "planning_horizon": "TACTICAL",
  "required_payoffs": [
    "第26—28章已有的掌前细暖、独练和移步结果在第29章转成无木片可自行起收的有限本领。",
    "有限本领在第30章眼前事务中产生具体动作选择，事务当章完成。",
    "唐穗此前想看晾定盘边的愿望在第31章获得亲见结果。",
    "第32章以真实任务条件和有用准备，为第33—40章完整执行与交付建立起点。"
  ],
  "soft_constraints": [
    "第29章少量复习足以支持新练习，不用整章对照记录；保留师生动作、对话与感受的场景空间。",
    "第30章的短时细暖须在搬放的实际动作链中起作用，不安排一段无关自检。",
    "第31章让唐穗自己观察、提问和选择，不要求所有人物同时出场或强发奖励。",
    "第32章以实际准备收束，章尾期待来自已选择的目标，不强制悬念、反转或突破。",
    "每章让生活细节、动作与关系自然支撑2500—3500中文字，不以反复边界声明充篇幅。"
  ],
  "arc_contributions": [
    {
      "change": "从纠正眼前动作推进到说明小本领的自身用途，并鼓励沈砚先自行实践、带着具体问题再来答疑。",
      "subject": "许庭的有限教学"
    },
    {
      "change": "从案前可重复的起收推进到无木片短时起收，以及在实际搬放事务中据自身手感调整做法。",
      "subject": "沈砚的基础运用"
    },
    {
      "change": "以明确的任务条件支持沈砚选择下一段山林工作，不预先保证后续交付结果。",
      "subject": "程观与沈砚的工作协商"
    }
  ],
  "budget_policy_ref": "authority-output:e028f0a6-b242-4990-b707-b2f4b09ca34f:book.bootstrap.production_profile:v1",
  "forbidden_payoffs": [
    "以许庭一句天赋评价、口头许可或新术名代替沈砚的实际练习与运用。",
    "以一回细暖宣称稳定、广泛的灵气运用。",
    "以灵气感受代替修盘者对陶盘质量的判断。",
    "以报名或排日程代替第32章的具体选择和行前动作。",
    "以第32章准备代替第33—40章完整任务的现场执行与明确交付。"
  ],
