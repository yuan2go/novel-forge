        "beats": [
          {
            "beat_id": "cg40-s1-b1",
            "ordinal": 1,
            "function": "从架上剩余的一只盘和约定木托起笔，沈砚对照平地上已摆好的两只盘，确认余下范围。唐穗继续看盘边影子与落点，不推断材质。",
            "expected_reader_effect": "接上上一章未完的实际工作，感到日影与余量都清楚可见。"
          },
