source = ({'operation_id': 'root', 'definition_version': '3.8.0', 'command_payload': {}, 'actor_id': 'operator', ...}, {'projec...n_execution': {'execution_result': {'outcome': 'TIMED_OUT'}, 'process_evidence': {'failure_code': 'PROCESS_TIMEOUT'}}})
monkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x110d51430>
boundary = 'unknown'

        return root, book, request, effect, candidate, error
    
    
    @pytest.mark.parametrize(
        "boundary",
        [
            "known",
            "unknown",
            "success",
            "held-reserve",
            "paid",
            "output",
            "foreign-actor",
            "accepted-frontier",
            "changed-grant",
            "lease",
            "accepted",
            "strict",
        ],
    )
    def test_only_known_preprose_member_timeout_is_eligible(source, monkeypatch, boundary):
        root, book, request, effect, candidate, error = source
        if boundary == "unknown":
            effect[1] = "UNKNOWN"
        if boundary == "success":
            effect[1] = "SUCCEEDED"
        if boundary == "held-reserve":
            effect[5] = "HELD"
        if boundary == "paid":
            candidate["pricing"]["accounting_basis"] = "API_USAGE"
        if boundary == "output":
            error["production_execution"]["execution_result"]["output_manifest_ref"] = (
                "partial"
            )
        if boundary == "foreign-actor":
            root["actor_id"] = "foreign"
        if boundary == "accepted-frontier":
            book["accepted_through_chapter"] = 1
        if boundary == "changed-grant":
            candidate["authorization_ref"] = "other-grant"
        if boundary == "strict":
            monkeypatch.setattr(recovery, "selected_book_template", lambda *a, **k: None)
        cursor = Cursor(
            root, effect, lease=boundary == "lease", accepted=boundary == "accepted"
        )
        if boundary == "lease":
            with pytest.raises(KernelError, match="Wait for the original execution lease"):
                recovery.source_evidence(
>                   cursor, book=book, request=request, principal=Principal()
                )

tests/unit/test_book_execution_recovery.py:148: 
_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ 

cursor = <tests.unit.test_book_execution_recovery.Cursor object at 0x110d53c80>
book = {'project_id': 'project', 'book_id': 'book', 'state': 'CHAPTER_RUNNING', 'active_chapter_request_id': 'request', ...}
request = {'chapter_root_operation_id': 'root', 'chapter_request_id': 'request', 'chapter_number': 1}
principal = <tests.unit.test_book_execution_recovery.Principal object at 0x110d53980>

    def source_evidence(cursor, *, book, request, principal):
        principal.require("book.authority.execute", book["project_id"])
        principal.require("chapter.authority.execute", book["project_id"])
        admission = selected_book_template(
            cursor, project_id=book["project_id"], book_id=book["book_id"]
        )
        if not admission:
            return None
        cursor.execute(
            "SELECT to_jsonb(o) FROM authority_operation o WHERE operation_id=%s AND project_id=%s FOR SHARE",
            [request["chapter_root_operation_id"], book["project_id"]],
        )
        row = cursor.fetchone()
        if not row:
            return None
        root = row[0]
        if (
            root["definition_version"] != "3.8.0"
            or root["command_payload"]
            .get("preparation_report", {})
            .get("author_draft_adoption")
            or root["actor_id"] != principal.principal_id
            or book["state"]
            not in {
                "CHAPTER_SUBMITTED",
                "CHAPTER_RUNNING",
                "CHAPTER_WAITING_RETRY",
                "CHAPTER_FAILED_RETRYABLE",
            }
            or book["active_chapter_request_id"] != request["chapter_request_id"]
            or request["chapter_number"] != book["accepted_through_chapter"] + 1
            or root["status"] not in {"WAITING_CHILDREN", "FAILED_RETRYABLE", "CANCELLED"}
        ):
            return None
>       if (root['project_id'] != book['project_id'] or root['workspace_id'] != book['workspace_id']
            ^^^^^^^^^^^^^^^^^^
            or request['project_id'] != book['project_id'] or request['book_run_id'] != book['book_run_id']
            or root['command_payload'].get('book_id') != book['book_id']
            or root['command_payload'].get('chapter') != request['chapter_number']):
E           KeyError: 'project_id'

