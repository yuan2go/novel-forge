                if stage == 'draft':
                    information_call_count += 1
                    if information_call_count == 1:
                        value['scene_artifacts'][0]['used_fact_ids'] = ['fact:hidden-cost']
                    else:
                        assert inputs.get('candidate_repair', {}).get('source_effect_id')
                        if information_call_count == 2:
