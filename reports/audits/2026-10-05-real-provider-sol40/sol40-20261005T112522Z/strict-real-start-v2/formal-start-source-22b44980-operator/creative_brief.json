          {
            "path": "author-v2/tone-and-pov.txt",
            "content": "\u7b80\u4f53\u4e2d\u6587\uff0c\u7384\u5e7b\u8f7b\u559c\u5267\uff0c\u57fa\u8c03\u660e\u5feb\u3001\u6e29\u6696\u3001\u6709\u751f\u6d3b\u6c14\uff0c\u7b2c\u4e09\u4eba\u79f0\u9650\u77e5\u3001\u4e3b\u8981\u89c6\u89d2\u56fa\u5b9a\u9646\u5706\u3002\u901a\u8fc7\u52a8\u4f5c\u3001\u5bf9\u767d\u8282\u594f\u548c\u53ef\u4fe1\u7684\u5947\u5e7b\u65e5\u5e38\u5f62\u6210\u5e7d\u9ed8\uff0c\u5141\u8bb8\u8f7b\u677e\u7684\u56f0\u96be\u4e0e\u9002\u91cf\u5192\u9669\u3002\u89d2\u8272\u4fdd\u6301\u57fa\u672c\u5c0a\u4e25\u548c\u5224\u65ad\u529b\uff1b\u4e0d\u9760\u5168\u5458\u964d\u667a\u3001\u6076\u610f\u7f9e\u8fb1\u3001\u5bc6\u96c6\u7f51\u7edc\u70ed\u6897\u3001\u53cd\u590d\u53e3\u5934\u89e3\u91ca\u7b11\u70b9\u6216\u5f3a\u884c\u8bef\u4f1a\u5236\u9020\u559c\u5267\u3002\u5c40\u52bf\u4e0e\u611f\u60c5\u7684\u63a8\u8fdb\u987b\u81ea\u7136\u63a5\u7eed\uff0c\u4e0d\u4ee5\u6c89\u91cd\u7684\u60ac\u7591\u6c1b\u56f4\u3001\u79d8\u5bc6\u8c03\u67e5\u548c\u8c1c\u5e95\u540a\u80c3\u53e3\u3002",
