          {
            "path": "author/original-premise.txt",
            "content": "\u6682\u5b9a\u540d\u300a\u6f6e\u706f\u85cf\u706b\u300b\u3002\u539f\u521b\u67b6\u7a7a\u4fee\u771f\u6d77\u57ce\uff0c\u4f4e\u9636\u706f\u5668\u4fee\u8865\u5320\u9646\u781a\u9760\u957f\u671f\u7ef4\u62a4\u548c\u6709\u6210\u672c\u7684\u8bd5\u9a8c\u79ef\u7d2f\u672c\u9886\uff1b\u4ed6\u7684\u6536\u76ca\u6765\u81ea\u6280\u827a\u3001\u8282\u7ea6\u4e0e\u53ef\u4fe1\u5408\u4f5c\uff0c\u4e0d\u9760\u7cfb\u7edf\u8d60\u9001\u6216\u6284\u53d6\u4ed6\u4eba\u529f\u6cd5\u3002\u57ce\u5185\u6570\u4e2a\u52bf\u529b\u4f9d\u8d56\u540c\u4e00\u6f6e\u6c50\u5c4f\u969c\u800c\u53c8\u4e92\u4e0d\u4fe1\u4efb\uff0c\u4ed6\u4ece\u5c40\u90e8\u5f02\u5e38\u4e0e\u5177\u4f53\u59d4\u6258\u9010\u6b65\u770b\u89c1\u98ce\u9669\u3002\u4f4e\u8c03\u6709\u5b9e\u9645\u4f5c\u7528\u548c\u4ee3\u4ef7\uff1b\u6c89\u9ed8\u53ef\u80fd\u4fdd\u62a4\u81ea\u8eab\uff0c\u4e5f\u53ef\u80fd\u8ba9\u5df2\u77e5\u5371\u9669\u843d\u5728\u4ed6\u4eba\u8eab\u4e0a\u3002\u6743\u529b\u4eba\u7269\u53ca\u4e3b\u8981\u5173\u7cfb\u7531\u672c\u4e66\u6b63\u5f0fFoundation\u72ec\u7acb\u751f\u6210\uff0c\u4e0d\u91c7\u7528\u7279\u5b9a\u53c2\u8003\u4f5c\u54c1\u7684\u4eba\u7269\u7ec4\u5408\u6216\u8bc6\u522b\u6027\u53cd\u8f6c\u300240\u7ae0\u5b8c\u6210\u4e00\u4e2a\u6709\u540e\u679c\u7684\u4e2d\u7bc7\u4e3b\u95ee\u9898\uff0c\u4e0d\u628a\u6bcf\u7ae0\u90fd\u5199\u6210\u5347\u7ea7\u3001\u6253\u8138\u6216 cliffhanger\u3002\u7b2c\u4e09\u4eba\u79f0\u9650\u77e5\uff0c\u4e3b\u8981\u89c6\u89d2\u56fa\u5b9a\u9646\u781a\uff1b\u8f7b\u5fae\u51b7\u5e7d\u9ed8\uff0c\u884c\u52a8\u5177\u4f53\u3001\u53d9\u8ff0\u514b\u5236\u3002",
            "content_hash": "sha256:708771a4974067f1349100eb53f9b120eba653d420a6cbd158b19368f394f601"
          },
          {
            "path": "author/work-craft.txt",
            "content": "\u672c\u4f5c\u54c1\u9009\u62e9\uff1a\u8c28\u614e\u51b3\u7b56\u3001\u6e10\u8fdb\u79ef\u7d2f\u3001\u56e0\u679c\u53ef\u8ffd\u7684\u6536\u76ca\u4e0e\u4ee3\u4ef7\u3001\u6709\u9650\u89c6\u89d2\u7684\u4fe1\u606f\u5dee\u548c\u9010\u6b65\u5efa\u7acb\u7684\u4fe1\u4efb\u3002\u53ef\u9009\u6280\u5de7\u5fc5\u987b\u7531\u89c4\u5212\u660e\u786e\u51b3\u5b9a\u9002\u7528\u4e0e\u8303\u56f4\u3002\u660e\u786e\u4e0d\u91c7\u7528\uff1a\u6bcf\u7ae0\u5f3a\u5236\u60ac\u5ff5\u94a9\u5b50\u3001\u56fa\u5b9a\u5546\u4e1a\u8282\u62cd\u3001\u65e0\u4ee3\u4ef7\u8fde\u7eed\u5347\u7ea7\u3001\u5fc5\u987b\u6253\u8138\u7684\u7ae0\u8282\u5957\u8def\u3001\u4e3a\u4e86\u51b2\u7a81\u5f3a\u8feb\u89d2\u8272\u72af\u4f4e\u7ea7\u9519\u8bef\u3002\u5956\u52b1\u53ea\u5728\u884c\u52a8\u786e\u6709\u76f8\u5e94\u540e\u679c\u65f6\u9002\u7528\uff0c\u4e0d\u80fd\u4ece\u901a\u7528\u6570\u503c\u9608\u503c\u5236\u9020\u3002",
            "content_hash": "sha256:1bd8be705eeff1e931bc110f3a0ebe2e3a12cc03b6e4a87ce0c5563a8fc68b36"
          },
          {
            "path": "author/originality-and-boundaries.txt",
            "content": "\u539f\u521b\u8981\u6c42\uff1a\u4e0d\u590d\u5236\u53c2\u8003\u4f5c\u54c1\u89d2\u8272\u59d3\u540d\u3001\u5b97\u95e8\u540d\u79f0\u3001\u795e\u901a/\u7cfb\u7edf\u8bbe\u5b9a\u3001\u5973\u5f3a\u7537\u5f31\u7684\u8bc6\u522b\u6027\u4eba\u7269\u7ec4\u5408\u3001\u5f00\u7bc7\u906d\u9047\u3001\u72ec\u7279\u53cd\u8f6c\u3001\u5177\u4f53\u60c5\u8282\u94fe\u3001\u5bf9\u767d\u6216\u8868\u8fbe\u3002\u6240\u6709\u65b0\u8bbe\u5b9a\u4e0e\u4e8b\u4ef6\u53ea\u7531\u672c\u4e66\u4f5c\u8005\u610f\u56fe\u548c\u6b63\u5f0f\u751f\u6210/\u6279\u51c6\u8d44\u4ea7\u51b3\u5b9a\u3002\u672a\u63a5\u7eb3\u5019\u9009\u3001\u5931\u8d25\u7a3f\u3001\u5176\u4ed6\u4e66\u7684Canon\u4e0d\u5f97\u63d0\u4f9b\u65e2\u6210\u4e8b\u5b9e\uff1b\u4f20\u95fb\u3001\u63a8\u6d4b\u3001\u672a\u6765\u610f\u56fe\u3001\u89d2\u8272\u6240\u77e5\u4e0e\u5ba2\u89c2\u4e8b\u5b9e\u4fdd\u6301\u533a\u522b\u3002",
            "content_hash": "sha256:823faa33ef27f48dd0569964624954a9f9d85428c1f0d34e8d97809657363f7c"
          }
