            "path": "author-v2/original-premise.txt",
            "content": "\u6682\u5b9a\u540d\u300a\u8fd9\u5bb6\u7075\u517d\u98df\u5802\u6709\u70b9\u5fd9\u300b\u3002\u539f\u521b\u7384\u5e7b\u5c0f\u9547\uff0c\u4eba\u4e0e\u7075\u517d\u5171\u540c\u751f\u6d3b\u3002\u4e3b\u89d2\u9646\u5706\u60f3\u628a\u4e00\u95f4\u4e0d\u8d77\u773c\u7684\u5c0f\u98df\u5802\u7ecf\u8425\u4e0b\u53bb\uff0c\u7ec3\u4e60\u6709\u9650\u4e14\u6709\u6210\u672c\u7684\u98df\u706b\u672f\uff1b\u7075\u517d\u7684\u98df\u6027\u3001\u4eba\u7684\u613f\u671b\u4e0e\u5404\u81ea\u8ba4\u771f\u8fc7\u5934\u7684\u751f\u6d3b\u4e60\u60ef\uff0c\u8ba9\u666e\u901a\u59d4\u6258\u5e38\u5e38\u53d8\u5f97\u70ed\u95f9\u3002\u6545\u4e8b\u4ee5\u7ecf\u8425\u65e5\u5e38\u3001\u4fee\u70bc\u4e2d\u7684\u5c0f\u8fdb\u6b65\u3001\u670b\u53cb\u76f8\u5904\u548c\u7075\u517d\u95f9\u51fa\u7684\u751f\u6d3b\u9ebb\u70e6\u4e3a\u4e2d\u5fc3\u3002\u5947\u5e7b\u89c4\u5219\u5177\u4f53\u800c\u80fd\u53cd\u590d\u9a8c\u8bc1\uff0c\u7b11\u70b9\u6765\u81ea\u4eba\u7269\u6b32\u671b\u9519\u4f4d\u3001\u4f53\u578b\u6216\u80fd\u529b\u5dee\u5f02\u3001\u884c\u52a8\u53cd\u9988\u4e0e\u5173\u7cfb\u9ed8\u5951\uff1b\u4e3b\u89d2\u8c28\u614e\u4f46\u613f\u610f\u505a\u4e8b\u3002\u7531\u6b63\u5f0fFoundation\u72ec\u7acb\u751f\u6210\u914d\u89d2\u3001\u4e16\u754c\u89c4\u5219\u548c\u4eba\u7269\u5173\u7cfb\uff0c\u4e0d\u9884\u8bbe\u53c2\u8003\u4f5c\u54c1\u7684\u8bc6\u522b\u6027\u89d2\u8272\u7ec4\u5408\u3002",
