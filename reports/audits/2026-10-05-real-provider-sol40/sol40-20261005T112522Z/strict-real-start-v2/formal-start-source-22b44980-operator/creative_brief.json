    "logical_ref": "asset-version:authority-output:caeb6b2b-2aa5-4684-9eca-717a62644bfb:creative.brief:v1",
    "content": {
      "idea": "\u6682\u5b9a\u540d\u300a\u6f6e\u706f\u85cf\u706b\u300b\u3002\u539f\u521b\u67b6\u7a7a\u4fee\u771f\u6d77\u57ce\uff0c\u4f4e\u9636\u706f\u5668\u4fee\u8865\u5320\u9646\u781a\u9760\u957f\u671f\u7ef4\u62a4\u548c\u6709\u6210\u672c\u7684\u8bd5\u9a8c\u79ef\u7d2f\u672c\u9886\uff1b\u4ed6\u7684\u6536\u76ca\u6765\u81ea\u6280\u827a\u3001\u8282\u7ea6\u4e0e\u53ef\u4fe1\u5408\u4f5c\uff0c\u4e0d\u9760\u7cfb\u7edf\u8d60\u9001\u6216\u6284\u53d6\u4ed6\u4eba\u529f\u6cd5\u3002\u57ce\u5185\u6570\u4e2a\u52bf\u529b\u4f9d\u8d56\u540c\u4e00\u6f6e\u6c50\u5c4f\u969c\u800c\u53c8\u4e92\u4e0d\u4fe1\u4efb\uff0c\u4ed6\u4ece\u5c40\u90e8\u5f02\u5e38\u4e0e\u5177\u4f53\u59d4\u6258\u9010\u6b65\u770b\u89c1\u98ce\u9669\u3002\u4f4e\u8c03\u6709\u5b9e\u9645\u4f5c\u7528\u548c\u4ee3\u4ef7\uff1b\u6c89\u9ed8\u53ef\u80fd\u4fdd\u62a4\u81ea\u8eab\uff0c\u4e5f\u53ef\u80fd\u8ba9\u5df2\u77e5\u5371\u9669\u843d\u5728\u4ed6\u4eba\u8eab\u4e0a\u3002\u6743\u529b\u4eba\u7269\u53ca\u4e3b\u8981\u5173\u7cfb\u7531\u672c\u4e66\u6b63\u5f0fFoundation\u72ec\u7acb\u751f\u6210\uff0c\u4e0d\u91c7\u7528\u7279\u5b9a\u53c2\u8003\u4f5c\u54c1\u7684\u4eba\u7269\u7ec4\u5408\u6216\u8bc6\u522b\u6027\u53cd\u8f6c\u300240\u7ae0\u5b8c\u6210\u4e00\u4e2a\u6709\u540e\u679c\u7684\u4e2d\u7bc7\u4e3b\u95ee\u9898\uff0c\u4e0d\u628a\u6bcf\u7ae0\u90fd\u5199\u6210\u5347\u7ea7\u3001\u6253\u8138\u6216 cliffhanger\u3002\u7b2c\u4e09\u4eba\u79f0\u9650\u77e5\uff0c\u4e3b\u8981\u89c6\u89d2\u56fa\u5b9a\u9646\u781a\uff1b\u8f7b\u5fae\u51b7\u5e7d\u9ed8\uff0c\u884c\u52a8\u5177\u4f53\u3001\u53d9\u8ff0\u514b\u5236\u3002",
      "genre": "\u539f\u521b\u4ed9\u4fa0\uff0c\u8c28\u614e\u751f\u5b58\u4e0e\u6280\u827a\u79ef\u7d2f",
      "audience": "\u559c\u6b22\u4f4e\u8c03\u6210\u957f\u3001\u4fe1\u606f\u5dee\u3001\u53ef\u4fe1\u5173\u7cfb\u4e0e\u6301\u7eed\u56e0\u679c\u7684\u6210\u5e74\u4e2d\u6587\u7c7b\u578b\u5c0f\u8bf4\u8bfb\u8005",
      "project_id": "nf-sol40-20261005T112522Z",
      "constraints": [
        "\u9a8c\u8bc1\u4e00\u672c\u539f\u521b\u4e2d\u6587\u4ed9\u4fa0\u5c0f\u8bf4\uff0c\u517140\u7ae0\uff0c\u6bcf\u7ae0\u6b63\u65875000\u20136000\u6c49\u5b57\uff08HAN_CHARACTERS_V1\uff0c\u6807\u70b9\u3001\u6570\u5b57\u3001\u7a7a\u767d\u3001\u62c9\u4e01\u5b57\u6bcd\u4e0d\u8ba1\uff09\uff0c\u603b\u6b63\u658720\u4e07\u201324\u4e07\u6c49\u5b57\u3002\u6a21\u578b\u56fa\u5b9aCodex gpt-6-sol\uff0c\u63a8\u7406medium\u3002\u5b8c\u6574\u7ecf\u5386\u4f5c\u8005\u8f93\u5165\u3001Foundation\u3001\u89c4\u5212\u3001\u6b63\u6587\u3001\u5ba1\u8bfb\u3001\u5fc5\u8981\u4fee\u8ba2\u3001Quality\u3001\u539f\u5b50\u63a5\u7eb3\u548c\u4e0b\u4e00\u7ae0\u72b6\u6001\u8bfb\u53d6\uff1b\u5931\u8d25\u4e0d\u5f97\u5192\u5145\u5b8c\u6210\u3002",
        "\u672c\u4f5c\u54c1\u9009\u62e9\uff1a\u8c28\u614e\u51b3\u7b56\u3001\u6e10\u8fdb\u79ef\u7d2f\u3001\u56e0\u679c\u53ef\u8ffd\u7684\u6536\u76ca\u4e0e\u4ee3\u4ef7\u3001\u6709\u9650\u89c6\u89d2\u7684\u4fe1\u606f\u5dee\u548c\u9010\u6b65\u5efa\u7acb\u7684\u4fe1\u4efb\u3002\u53ef\u9009\u6280\u5de7\u5fc5\u987b\u7531\u89c4\u5212\u660e\u786e\u51b3\u5b9a\u9002\u7528\u4e0e\u8303\u56f4\u3002\u660e\u786e\u4e0d\u91c7\u7528\uff1a\u6bcf\u7ae0\u5f3a\u5236\u60ac\u5ff5\u94a9\u5b50\u3001\u56fa\u5b9a\u5546\u4e1a\u8282\u62cd\u3001\u65e0\u4ee3\u4ef7\u8fde\u7eed\u5347\u7ea7\u3001\u5fc5\u987b\u6253\u8138\u7684\u7ae0\u8282\u5957\u8def\u3001\u4e3a\u4e86\u51b2\u7a81\u5f3a\u8feb\u89d2\u8272\u72af\u4f4e\u7ea7\u9519\u8bef\u3002\u5956\u52b1\u53ea\u5728\u884c\u52a8\u786e\u6709\u76f8\u5e94\u540e\u679c\u65f6\u9002\u7528\uff0c\u4e0d\u80fd\u4ece\u901a\u7528\u6570\u503c\u9608\u503c\u5236\u9020\u3002",
        "\u539f\u521b\u8981\u6c42\uff1a\u4e0d\u590d\u5236\u53c2\u8003\u4f5c\u54c1\u89d2\u8272\u59d3\u540d\u3001\u5b97\u95e8\u540d\u79f0\u3001\u795e\u901a/\u7cfb\u7edf\u8bbe\u5b9a\u3001\u5973\u5f3a\u7537\u5f31\u7684\u8bc6\u522b\u6027\u4eba\u7269\u7ec4\u5408\u3001\u5f00\u7bc7\u906d\u9047\u3001\u72ec\u7279\u53cd\u8f6c\u3001\u5177\u4f53\u60c5\u8282\u94fe\u3001\u5bf9\u767d\u6216\u8868\u8fbe\u3002\u6240\u6709\u65b0\u8bbe\u5b9a\u4e0e\u4e8b\u4ef6\u53ea\u7531\u672c\u4e66\u4f5c\u8005\u610f\u56fe\u548c\u6b63\u5f0f\u751f\u6210/\u6279\u51c6\u8d44\u4ea7\u51b3\u5b9a\u3002\u672a\u63a5\u7eb3\u5019\u9009\u3001\u5931\u8d25\u7a3f\u3001\u5176\u4ed6\u4e66\u7684Canon\u4e0d\u5f97\u63d0\u4f9b\u65e2\u6210\u4e8b\u5b9e\uff1b\u4f20\u95fb\u3001\u63a8\u6d4b\u3001\u672a\u6765\u610f\u56fe\u3001\u89d2\u8272\u6240\u77e5\u4e0e\u5ba2\u89c2\u4e8b\u5b9e\u4fdd\u6301\u533a\u522b\u3002",
        "\u4e0d\u5f97\u7528\u6458\u8981\u3001\u91cd\u590d\u6bb5\u843d\u6216\u65e0\u6548\u89e3\u91ca\u51d1\u8db3\u957f\u5ea6\u3002\u6bcf\u7ae0\u63a5\u7eb3\u540e\uff0c\u540e\u7eed\u7ae0\u8282\u4ec5\u6d88\u8d39\u7cbe\u786e\u5df2\u63a5\u7eb3\u6b63\u6587\u6240\u5bf9\u5e94\u7684Canon\u548cStory State\u3002",
        "40\u7ae0\u5b8c\u6210\u672c\u4e66\u5f53\u524d\u4e3b\u95ee\u9898\uff0c\u4fdd\u7559\u5408\u7406\u4e16\u754c\u4f59\u6ce2\uff1b\u7ed3\u5c40\u5fc5\u987b\u7531\u524d\u6587\u5177\u4f53\u884c\u52a8\u4e0e\u4ee3\u4ef7\u652f\u6491\uff0c\u4e0d\u80fd\u4ee5\u5230\u8fbe\u7ae0\u6570\u5ba3\u5e03\u4e00\u5207\u6210\u529f\u3002"
      ],
