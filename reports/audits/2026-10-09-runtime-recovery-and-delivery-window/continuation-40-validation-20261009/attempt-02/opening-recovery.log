        alternate = _seed_candidate_and_evaluation(
            project_id=project_id,
            role=FoundationRole.CREATIVE_FOUNDATION,
            label="alternate",
            alternate=True,
            parent_candidates=selected,
        )
        _activate_story_design(
            database_url=database_url,
            project_id=project_id,
