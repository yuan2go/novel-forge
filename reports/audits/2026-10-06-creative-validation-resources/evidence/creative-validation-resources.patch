+++ b/src/novel_forge/modules/production_execution/membership_identity.py
@@ -0,0 +1,36 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+
+def observe_membership_identity(codex_home: str) -> dict[str, str]:
+    path = Path(codex_home) / "auth.json"
+    try:
+        auth: Any = json.loads(path.read_text())
+    except (OSError, ValueError) as exc:
+        raise ValueError("CODEX_MEMBERSHIP_AUTH_UNAVAILABLE") from exc
+    if (not isinstance(auth, dict) or auth.get("auth_mode") != "chatgpt"
+            or auth.get("OPENAI_API_KEY") or not isinstance(auth.get("tokens"), dict)):
+        raise ValueError("CODEX_MEMBERSHIP_AUTH_REQUIRED")
+    tokens = auth["tokens"]
+    if not all(isinstance(tokens.get(key), str) and tokens[key].strip()
+               for key in ("account_id", "access_token", "refresh_token")):
+        raise ValueError("CODEX_MEMBERSHIP_IDENTITY_INCOMPLETE")
+    account = hashlib.sha256(tokens["account_id"].encode()).hexdigest()
+    return {"version": "codex-membership-identity.v1", "auth_mode": "chatgpt",
+            "billing_channel": "ACCOUNT_ENTITLEMENT", "account_ref": "codex-account:sha256:" + account}
+
+
+def require_membership_identity(codex_home: str, expected: dict[str, str]) -> None:
+    if observe_membership_identity(codex_home) != expected:
+        raise ValueError("CODEX_MEMBERSHIP_IDENTITY_DRIFT")
+
+
+def observed_paid_binding(account_ref: str, credential: str) -> dict[str, str]:
+    if not account_ref.strip() or not credential.strip():
+        return {}
+    return {"version": "configured-api-billing-binding.v1", "provider": "deepseek",
+            "account_ref": account_ref, "credential_ref": "sha256:" + hashlib.sha256(credential.encode()).hexdigest()}
diff --git a/src/novel_forge/modules/production_execution/resource_planning.py b/src/novel_forge/modules/production_execution/resource_planning.py
new file mode 100644
index 00000000..b1bf6b14
--- /dev/null
+++ b/src/novel_forge/modules/production_execution/resource_planning.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+from decimal import Decimal
+from math import ceil
+from typing import Any, Mapping
+
+from .execution_template import BOOK_USAGE_SQL
+
+
+def rolling_work_estimate(cursor: Any, *, project_id: str, book_id: str,
+                          input_tokens: int, output_tokens: int, template: Mapping[str, Any]) -> dict[str, Any]:
+    cursor.execute("""SELECT target_chapter_count,accepted_through_chapter FROM authority_book_production
+        WHERE project_id=%s AND book_id=%s ORDER BY created_at DESC LIMIT 1""", [project_id, book_id])
+    goal = cursor.fetchone()
+    if goal is None:
+        cursor.execute("""SELECT (frozen_stage_inputs #>> '{generation_policy,target_chapters}')::integer,0
+            FROM authority_story_formation_run WHERE project_id=%s AND book_id=%s
+            ORDER BY created_at DESC LIMIT 1""", [project_id, book_id])
+        goal = cursor.fetchone()
+    cursor.execute(f"""SELECT r.provider,count(*),COALESCE(avg(r.actual_tokens),0),COALESCE(avg(r.settled_amount),0)
+        FROM authority_budget_reservation r JOIN authority_external_effect e USING(external_effect_id)
+        WHERE r.project_id=%s AND {BOOK_USAGE_SQL}
+          AND r.status='SETTLED' GROUP BY r.provider""", [project_id, book_id, book_id, book_id])
+    history = {row[0]: {"calls": int(row[1]), "average_tokens": ceil(row[2]),
+                        "average_paid_amount": str(row[3]) if row[0] == "deepseek" else None}
+               for row in cursor.fetchall()}
+    cursor.execute(f"""SELECT CASE WHEN e.request_payload #>>
+        '{{_production_execution,capability_runtime,routing_decision,task,task_type}}'
+        IN ('model_reference_evaluate','model_reference_adjudicate')
+        OR e.request_payload #>> '{{_production_execution,capability_runtime,routing_decision,mode}}'='BENCHMARK_CHALLENGER'
