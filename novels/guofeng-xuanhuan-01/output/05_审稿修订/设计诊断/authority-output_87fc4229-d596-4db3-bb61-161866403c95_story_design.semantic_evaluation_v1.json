  "content": {
    "evaluation": {
      "evaluations": [
        {
          "layer": "STORY_FOUNDATION",
          "criteria": [
            {
              "verdict": "PASS",
              "criterion": "WORLD_RULE_COHERENCE",
              "rationale": "听隙的接触渠道、信息范围与判断误差相互一致，辨弱不自动提供破防力量；境界优势、材料损耗与局部脱险条件不存在互相取消的例外。航程与速度计算一致，消息受实际路线和岗位权限约束，能够维持行动及限知叙述的连续性。",
              "evidence_refs": [
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/technology_power",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/space_time_geography",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/information_communication"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "RULE_COST_AND_LIMIT",
              "rationale": "能力运用、修炼、养刃和履约均有具体成本与失效边界：十二个有效训练日及末段测试、过载后的功能损失、不可逆刃材消耗、批次补给和有偿保障形成可执行约束。价格尺度支持收入与支出的比较，替代采购仍须支付时间和性能代价。候选已规定决定性行动的后果与状态变化须在正文显露；本阶段无需已有章节来证明执行。",
              "evidence_refs": [
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/rules",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/economy",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/ecology_resources"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "CONFLICT_GENERATION_CAPACITY",
              "rationale": "门派保障收入、散匠工法自主、渡户生计、商号交期与渡务秩序具有交叉且不一致的利益。签约期限、补给等待和真实护运要求能够持续产生筹资、议价、误判、协作与验收冲突；各势力拥有独立资源和压力，冲突无需依赖全员恶意或单一反派维持。",
              "evidence_refs": [
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/factions",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/politics_factions",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/space_time_geography"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "CHARACTER_AGENCY_SUPPORT",
              "rationale": "入门保障与独立经营各有真实收益和义务，陶靖的待遇及权利让渡条件保持为待选择事项。叶满汀、杜衡和其他合作者保有生计目标、拒绝权及信息边界。明确同意、有限责任、替代履约保障与退出安排允许人物通过议价、缩小业务或承担补救改变局面，同时保留选择的后果。",
              "evidence_refs": [
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/society_class",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/politics_factions",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/rules/7"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "LONGFORM_EVOLUTION_CAPACITY",
              "rationale": "首卷的个人手艺与有限合约可自然扩展至师承授权、共同成果归属和多队分配，冲突规模增长具有制度与资源基础。远域路线、更高能力和跨地结算均设置了具体扩展触发条件，并禁止追溯改写旧约或能力；既有收入和关系回报可保留。已具备世界基础阶段所需的长篇演化容量，无需预先生成后续卷章计划。",
              "evidence_refs": [
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/objective",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/deferred_dimensions",
                "authority-output:63f8d2dc-c959-4f3c-b4a8-70d08a51a5de:story_planning.candidate:v1@sha256:79d8fb41755ef21b38462b0215ea9d37aca416bf8abae5a6cea4c3534f229b96#/selected_inputs/0/candidate/world_foundation/sections/society_class"
              ],
              "repair_directive": ""
            }
