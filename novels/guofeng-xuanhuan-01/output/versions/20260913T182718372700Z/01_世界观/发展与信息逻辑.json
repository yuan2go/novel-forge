  "content": {
    "sections": {
      "information_communication": {
        "depth": "WORKING",
        "content": "消息依人、船、纸件与近距离旗哨传递，无跨地即时通信。旗哨只表达预先约定的少量指令，河弯、雨雾与噪声可阻断。书信使用既定路线和行程，最快到达仍需实际运送。渡务署知道已登记事项，工坊知道自己的检修，药铺知道自己的批次，船户知道亲历航程与自家船况；跨账核验需授权、费用或争议程序。回澜门内部按岗位分配信息，陶靖与杜衡不自动共享所有信息；散户和商号同样没有全体共享的账本。见证只能证明亲见事项，货物验收与证言真假须分别判断。信息在世界中存在不等于陆照已知；每条关键消息须在后续记录来源、载体、发出与到达时间、接收人及可信程度。"
      },
      "core_laws": {
        "depth": "WORKING",
        "content": "候选世界第一规则：可用本领必须有承载，承诺必须有承担者。身体承载真气，材料与维护承载兵刃，人、船、补给与报酬承载护运。声望、比试与善意不能代替这些条件。死亡不可逆；无复活、时间回退、失忆免债或系统赐予。所有硬限制同时约束陆照、伙伴与对手。决定性行动须显露具体后果或不可逆代价，并可定位状态变化；胜利允许保持有效。"
      }
    },
    "rules": [
      {
        "rule_id": "rule:irreversibility",
        "category": "core_laws",
        "predicate": {
          "field": "consequence_reversal_available",
          "value": false,
          "operator": "EQUALS",
          "entity_key": "system:existence",
          "state_kind": "world_rule",
          "requirement_id": "requirement:irreversibility"
        },
        "statement": "死亡、已经消耗的钱物与过去时间不能以复活、时间回退或失忆免债恢复。正常休息和治疗是连续恢复，不是逆转后果。",
        "enforcement": "HARD",
        "consequences": [
          "治疗、误工和照护须实际支付。",
          "恢复战斗能力不自动恢复信任、积蓄和错过的机会。"
        ],
        "applicability": [
          "world_state",
          "character_state",
          "consequence_state"
        ]
      },
      {
        "rule_id": "rule:information_delay",
        "category": "information_communication",
        "predicate": {
          "field": "instant_remote_communication_available",
          "value": false,
          "operator": "EQUALS",
          "entity_key": "system:communication",
          "state_kind": "world_rule",
          "requirement_id": "requirement:information_delay"
        },
        "statement": "消息经人、船或纸件行走，旗哨仅用于近距离预定指令；无跨地即时通信。见证、记录与传闻均有证明范围。",
        "enforcement": "HARD",
        "consequences": [
          "核验消耗时间与费用，证人和文书必须实际到达。",
          "世界中的信息不能自动成为陆照或整支势力共享的知识。"
        ],
        "applicability": [
          "character_knowledge",
          "character_belief",
          "disclosure_event",
          "timeline_event"
        ]
      },
      {
        "rule_id": "rule:causal_cost",
        "category": "core_laws",
        "predicate": {
          "field": "decisive_action_consequence_trace_required",
          "value": true,
          "operator": "EQUALS",
          "entity_key": "system:causal_cost",
          "state_kind": "world_rule",
          "requirement_id": "requirement:causal_cost"
        },
        "statement": "依据knowledge:chapter-causal-cost:v1，决定性章节行动须在正文显露具体后果或不可逆代价，并建立可定位的状态变化。后果可以有利，不要求每次胜利受伤。",
        "enforcement": "HARD",
        "consequences": [
          "审查应能定位行动、后果与新状态。",
          "既有资源消耗和损失不得被胜利遮蔽，已经挣得的成长与收入也不得被任意撤销。"
        ],
        "applicability": [
          "consequence_state",
          "reward_event",
          "payoff_event"
        ]
      }
    ]
