              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "GENRE_ALIGNMENT",
              "rationale": "面向成年中文读者的现实救援、证据追查和群像责任冲突保持一致。限知视角、有限资源及不保证原谅的成长回报支持这一阅读定位；没有以未经证实的阴谋或主角万能承诺改变类型预期。",
              "evidence_refs": [
                "authority-output:4c25311f-c3c2-4379-8caf-251d26b5d5c2:story_planning.candidate:v1#/selected_inputs/0/candidate/objective",
