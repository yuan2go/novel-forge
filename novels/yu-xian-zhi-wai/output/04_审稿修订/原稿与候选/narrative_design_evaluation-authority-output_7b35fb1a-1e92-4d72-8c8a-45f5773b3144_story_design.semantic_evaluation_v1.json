    "evaluation": {
      "evaluations": [
        {
          "layer": "STORY_INTENT",
          "criteria": [
            {
              "verdict": "PASS",
              "criterion": "ENDING_DIRECTION_CLARITY",
              "rationale": "终局明确指向实际交付完成、责任重新确认及履约动作收束，并分别规定核心疑点、旧签名、关系变化和未尽义务的闭合条件。具体物件与地点留待接纳事实确定，符合结尾意图阶段，不影响方向清晰度。",
              "evidence_refs": [
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/ending_direction",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/closure_conditions"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "PROTAGONIST_COST",
              "rationale": "代价落实为保留可被追责的记录、接受拒绝并放弃快捷方案，以及实际补救占用休息或其他机会。行动、更改安排或责任边界、履行后的损失形成可验证链条，同时明确赞誉和道歉不能抹去成本。当前阶段已规定正文实现要求，无须提前提供章节证据。",
              "evidence_refs": [
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/protagonist_cost",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/closure_conditions/3",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/constraints/8"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "TRANSFORMATION_REACHABILITY",
              "rationale": "转变具有可执行的行为路径：从自行判定安排完成，到让受影响者核对、接受异议、更正错误并履行明确责任。规则和合作边界须在此前冲突中影响行动，且成长不依赖无条件原谅或包揽责任，具备渐进达成的条件。",
              "evidence_refs": [
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/protagonist_cost",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/closure_conditions/3",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/constraints/9"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "THEME_CLOSURE_ALIGNMENT",
              "rationale": "有限资源中的帮助、证据边界与具体担当，通过真正可用的交付、可追问的责任和保留分歧的合作实现闭合。结尾动作回应等待者，同时保留已经发生的损失，与目标一致；禁止主题演说、表彰或万能赎罪替代兑现。",
              "evidence_refs": [
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/objective",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/ending_direction",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/closure_conditions/7",
                "authority-output:0353ce66-51d7-4f6a-9792-9a38c886eb45:story_planning.candidate:v1#/selected_inputs/0/candidate/unacceptable_shortcuts"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "LONGFORM_REACHABILITY",
              "rationale": "明确区分六章兑现、十二章责任交接、首弧及三卷全书尺度；后续推进来自已兑现救助产生的空间、运输、轮班和照料负担，而非拖延旧谜底。终局允许按接纳后果调整未执行内容，并要求主线承诺完成后收束，具备结尾意图阶段所需的长篇延展与抵达机制。",
              "evidence_refs": [
