  "content": {
    "evaluation": {
      "evaluations": [
        {
          "layer": "STORY_INTENT",
          "criteria": [
            {
              "verdict": "PASS",
              "criterion": "CORE_CONFLICT_CLARITY",
              "rationale": "二十八张实物与三十六张记录的矛盾、连续缺号及岑禾旧签名共同构成明确的调查对象和个人牵连。及时救助与核实责任同时施压；有限资源、权限和失去信任的恐惧使冲突能够落实为有成本的选择，且未将开局线索越界认定为罪责确证。",
              "evidence_refs": [
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/core_conflict",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/core_fear"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "READER_FIT",
              "rationale": "目标读者偏好具体劳动、人物争执、有代价选择和阶段解谜，候选以可见物件建立疑问，以限知追查和生活后果维持阅读兴趣。前三章的递进吸引点、前六章的交付兑现及后续影响与该读者定位相符，创意阶段的阅读承诺明确。",
              "evidence_refs": [
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/target_reader",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/narrative_engine",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/style_profile/genre_conventions"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "DIFFERENTIATION",
              "rationale": "首十二章封闭的三十六张编号床、调查者本人需要更正的签名，以及到达、使用、接收之间的证据边界形成了相互作用的叙事机制。解谜结果继续触发分配和责任冲突，差异化体现在行动结构与主角成长中；本判断不构成对外部作品的原创性比对认证。",
              "evidence_refs": [
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/differentiation",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/constraints/0",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/core_desire"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "SERIALIZATION_CAPACITY",
              "rationale": "候选建立了差异或需求、人物交涉、行动成本、局部答案、后果引出新要求的持续因果循环，并明确四个三章组的功能及第十二章可经实际交接检验的阶段变化。三卷主题由完成交付递进至承担转移成本和多人回应责任，具备创意基础阶段的长篇生成潜力；180章容量仍属待后续实践验证的方向。章内行动、后果与状态变化已纳入约束，无需此阶段提供尚未生成的正文或下游计划。",
              "evidence_refs": [
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/serialization_potential",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/narrative_engine",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/constraints/8",
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/constraints/10"
              ],
              "repair_directive": ""
            },
            {
              "verdict": "PASS",
              "criterion": "EMOTIONAL_CONTRACT",
              "rationale": "情感承诺包含救助落实、错误追责撤回和需求得到答复等具体回报，同时允许受助者保留异议、主角承认漏问及承担更正成本。表达示范以等待、撤回越界要求和生活空间受占呈现这些张力，支持克制而有温度的阅读体验；示范仅作为设计证据，不视为已发生的章节事实。",
              "evidence_refs": [
                "authority-output:93516014-93a9-45ed-8911-12a6410acf7f:story_planning.candidate:v1#/selected_inputs/0/candidate/emotional_contract",
