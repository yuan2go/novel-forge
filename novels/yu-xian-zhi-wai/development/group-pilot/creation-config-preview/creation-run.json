      "platform_profile": {
        "operation": "chapter.platform_profile.author",
        "content": {
          "type": "platform_profile",
          "safe_summary": "六章内部盲评，2000–3500汉字/章。",
          "structured_facts": [
            {
              "key": "platform_rules",
              "value": {
                "chapter_length": {
                  "unit": "HAN_CHARACTERS_V1",
                  "minimum": 2000,
                  "maximum": 3500
                },
                "format": {
                  "paragraph_max": 500
                },
                "sensitive_content": [],
                "ai_content": {
                  "mode": "internal"
                },
                "opening": [
                  "通过具体行动建立当前冲突与人物所知边界"
                ],
                "rhythm": [
                  "建立、推进、兑现须有可定位的正文证据"
                ],
                "publish_metadata": {
                  "title_required": true
                }
              }
            }
          ],
          "profile_id": "chinese-private-pilot-v1",
          "constraints": [
            "连续六章，每章2000–3500汉字；至少两个章组，每组三章。",
            "第三人称限知，固定岑禾视角；未知、传闻、后台发生与正式事实分开。",
            "资源变化必须有来源、成本、行动和后果，不得凭空补充。",
            "第一章铺设一项第五或第六章才能兑现的承诺；中途不得以提及替代兑现。",
            "角色知情变化必须经过实际获知路径；读者所知不能自动成为人物所知。",
            "至少一项后台准备跨章推进；仅在获得可验证信息后披露给视角人物。",
            "角色通过欲望、误解和有代价的行动推动故事，避免旁白教学和术语堆砌。",
            "前三章接纳后，按冻结的未来改纲指令修改第四至六章；前三章历史保持原样。",
            "收束六章内主要抉择，同时保留有依据的追读悬念。",
            "独立生成两组所有世界、人物和上层规划；不得共享吸收过知识的规划或上下文。"
          ]
        }
      },
