zed_order":1,"number":null,"original_order":1,"raw_file_hash":"sha256:1a8160cefb90f353cb20fe1ae8dead4718e69b42dfb3d0379d8028ad106c8656","source_file_key":"sha256:095e4f531b44241e353c2957ce10e49eb00bfff4724e579648a94ea4ce99f315","source_key":"body","title":"12.2: Pulling Suction of a Fluid","unit_id":"unit:5956758eb27fb687c7fb54cdb6c435b3f713d2b538b99e03a6bf81cc79eee11b","volume":""}],"version":"corpus-integrity.v2","work_completion":"UNKNOWN"},"parser_hash":"sha256:fcdc66791df8e20cb8cc7dee8eba2ae683c6a59bc7cf6d1452f545b072a0d573","parser_profile":{"completeness":"EXCERPT","constants":{"author":"Jessy Haid / Northeast Wisconsin Technical College","title":"12.2: Pulling Suction of a Fluid","work_id":"hydraulics-11"},"encoding":"utf-8","expected_units":1,"fields":{"text":"text"},"filters":{},"format":"html","html_body_selector":".mt-content-container","html_remove_selectors":["script","style","nav","header","footer","noscript"],"layout":"SINGLE_WORK","normalization":{"boundaries":[],"candidate_threshold":0.8,"duplicate_body_min_chars":128,"expected_toc":[],"external_work_ids":[],"heading_max_chars":100,"max_unit_bytes":2000000,"min_body_chars":80,"segmentation":"EXPLICIT","toc_evidence":"","unicode_form":"NFC","version":"chinese-longform.v2","work_completion":"UNKNOWN"},"records_path":"item","version":"corpus-parser.v3","work_key_encoding":"VALUE"},"schema_version":"corpus-parsed-work.v1","title":"hydraulics-11","units":[{"author":"Jessy Haid / Northeast Wisconsin Technical College","body_content_hash":"sha256:1e6b8a53b36b7f0bcbb5364f68cb020ddd1bc9c77ad63406e97c9ba381c44d9b","chapter_id":"unit:5956758eb27fb687c7fb54cdb6c435b3f713d2b538b99e03a6bf81cc79eee11b","confirmed_heading_chars":0,"edition_id":"source-edition","normalization_evidence":{"normalized_unicode_length":2304,"normalized_utf8_bytes":2318,"precision":"STRUCTURED_LOCATOR","raw_text_changed":false,"steps":["STRICT_DECODE","NEWLINE_LF","NFC"]},"normalized_content_hash":"sha256:c12cbe59bac5ee07b9b3c3416a5a19667077aeffbcad60467ca2d26ab8202894","order":1,"original_content_hash":"sha256:c12cbe59bac5ee07b9b3c3416a5a19667077aeffbcad60467ca2d26ab8202894","parser":{"profile_hash":"sha256:fcdc66791df8e20cb8cc7dee8eba2ae683c6a59bc7cf6d1452f545b072a0d573"},"physical_order":1,"raw_blob_id":"7fac2772-ea06-5afc-8842-d6300be94928","raw_file_hash":"sha256:1a8160cefb90f353cb20fe1ae8dead4718e69b42dfb3d0379d8028ad106c8656","source_chapter_id":"body","source_locator":{"container_path":null,"field":"text","offset_kind":"HTML_SELECTOR","original_byte_offset":null,"path":"hydraulics-11.html","record":1,"selector":".mt-content-container"},"text":"Figure \\(\\PageIndex{1}\\): Schematic representation of suction flow.\nOne common misconception in hydraulics is that a pump \"sucks\" oil out of the reservoir. In reality,\na pump doesn’t pull fluid in —it relies on atmospheric pressure to push the oil into its inlet\n.\nLet’s break that down.\nThe Role of Pressure Differential\nFluid always moves from areas of higher pressure to lower pressure. A hydraulic pump takes advantage of this by creating a\nlow-pressure area\nat its inlet during rotation. When the pump begins to turn, the internal components (such as gears or pistons)\ncreate space at the inlet\n, increasing its internal cavity space and reducing the pressure below atmospheric pressure.\nAt the same time, the surface of the reservoir is exposed to the atmosphere. Since atmospheric pressure is now\nhigher than the pressure at the pump inlet\n, it pushes the oil through the suction line into the pump.\nThis flow process only works\nif there’s a clear, unrestricted path\nfor the oil to follow.\nIssues That Affect Suction Flow\nIf anything restricts the inlet flow, the pressure differential may not be enough to move the oil fast enough. This can result in\ncavitation\nor\npump starvation\n, which are damaging to the pump.\nHere are a few things that can cause this:\nClogged inlet filters\nToo small or too long of a suction line\nPoor reservoir design or low oil levels\nEven a simple restriction can prevent oil from reaching the pump in time, which may lead to internal scoring, noise, loss of flow, or even total pump failure.\nEffect of Altitude\nFigure \\(\\PageIndex{2}\\): Schematic representation of altitude's effect on suction pressure.\nAnother factor to consider is\nelevation\n. At higher altitudes,\natmospheric pressure decreases\n, which means there’s\nless force available\nto push the oil into the pump inlet.\nFor example, a system designed to run at\nsea level\nin Seattle, Washington, might not operate correctly at high elevation in\nDenver, Colorado\n. The atmospheric pressure in Denver is lower, so the effective suction pressure drops. This could cause performance issues—or worse, pump damage—if the system isn't adjusted for the new conditions.\nDesigners must account for this when sizing suction lines and selecting pumps, especially for systems expected to operate in a wide range of altitudes.","title":"12.2: Pulling Suction of a Fluid","volume":"","work_id":"hydraulics-11","work_title":"hydraulics-11"}],"work_id":"hydraulics-11"}